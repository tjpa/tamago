# Copy these into Dokploy's Environment tab for the compose application.
# Never commit real values.

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Cloudflare R2 (S3-compatible). Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=tamago-invoices
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
